# API Settings
PROJECT_NAME="Kimia Vulnerability Scanner"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database
POSTGRES_URL="postgresql://kimia:kimia_password@localhost:5432/kimia_db"

# Redis
REDIS_URL="redis://localhost:6379/0"

# Keycloak Authentication
KEYCLOAK_SERVER_URL="http://localhost:8080"
KEYCLOAK_REALM_NAME="kimia"
KEYCLOAK_CLIENT_ID="kimia-backend"
KEYCLOAK_CLIENT_SECRET=""

# AI Engine Configuration
# AI_PROVIDER options: "ollama", "gemini", or "openai"
AI_PROVIDER="gemini"
AI_MODEL="gemini-1.5-flash"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
AI_ENDPOINT="http://192.168.1.56:11434/api/chat"
